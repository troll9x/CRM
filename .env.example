# Sao chép thành .env cho môi trường local. Không commit .env.
POSTGRES_DB=son_crm
POSTGRES_USER=son_crm
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://son_crm:replace-with-a-local-password@localhost:5432/son_crm?schema=public

API_PORT=4000
INTEGRATIONS_WORKER_ENABLED=false
FACEBOOK_APP_SECRET=replace-with-facebook-app-secret
FACEBOOK_APP_ID=
FACEBOOK_GRAPH_API_VERSION=
# Set exact HTTPS tunnel/staging URL before Meta OAuth; localhost is only for isolated tests.
FACEBOOK_OAUTH_REDIRECT_URI=
FACEBOOK_OAUTH_SCOPES=
FACEBOOK_LOGIN_CONFIG_ID=
INTEGRATION_TOKEN_ENCRYPTION_KEY=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-local-verification-token
ZALO_OA_SECRET_KEY=replace-with-zalo-oa-webhook-secret-key
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OAUTH_REDIRECT_URI=
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Chỉ dùng để seed local/test. Seed từ chối chạy trong production.
SEED_OWNER_EMAIL=owner@crm.local
SEED_OWNER_PASSWORD=replace-with-a-strong-local-password
SEED_OWNER_NAME=Chủ cửa hàng
