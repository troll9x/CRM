model IntegrationStaffAccess {
  id           String                @id @default(cuid())
  businessId   String                @map("business_id")
  connectionId String                @map("connection_id")
  staffId      String                @map("staff_id")
  canRead      Boolean               @default(true) @map("can_read")
  canSend      Boolean               @default(false) @map("can_send")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  staff        StaffUser             @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([connectionId, staffId])
  @@index([businessId, staffId, canRead])
  @@map("integration_staff_accesses")
}

model IntegrationAuthAttempt {
  id                    String                       @id @default(cuid())
  businessId            String                       @map("business_id")
  actorId               String                       @map("actor_id")
  provider              IntegrationProvider
  stateHash             String                       @unique @map("state_hash")
  redirectUri           String                       @map("redirect_uri")
  reconnectConnectionId String?                      @map("reconnect_connection_id")
  status                IntegrationAuthAttemptStatus @default(PENDING)
  expiresAt             DateTime                     @map("expires_at")
  claimedAt             DateTime?                    @map("claimed_at")
  credentialCiphertext  String?                      @map("credential_ciphertext")
  availableAccounts     Json?                        @map("available_accounts")
  errorCode             String?                      @map("error_code")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")
  business              Business                     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor                 StaffUser                    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([businessId, actorId, status, expiresAt])
  @@map("integration_auth_attempts")
}

// Durable inbox + DB-backed job row. Payload contains only normalized/minimal fields.
model IntegrationJob {
  id               String                @id @default(cuid())
  businessId       String                @map("business_id")
  connectionId     String                @map("connection_id")
  kind             IntegrationJobKind
  status           IntegrationJobStatus  @default(PENDING)
  idempotencyKey   String                @map("idempotency_key")
  externalEventId  String?               @map("external_event_id")
  providerObjectId String?               @map("provider_object_id")
  payload          Json
  providerAt       DateTime?             @map("provider_at")
  attempts         Int                   @default(0)
  maxAttempts      Int                   @default(12) @map("max_attempts")
  availableAt      DateTime              @default(now()) @map("available_at")
  leaseOwner       String?               @map("lease_owner")
  leaseExpiresAt   DateTime?             @map("lease_expires_at")
  lastErrorCode    String?               @map("last_error_code")
  receivedAt       DateTime              @default(now()) @map("received_at")
  completedAt      DateTime?             @map("completed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  business         Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  connection       IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([connectionId, idempotencyKey])
  @@unique([connectionId, externalEventId])
  @@index([status, availableAt, leaseExpiresAt])
  @@index([businessId, connectionId, receivedAt])
  @@map("integration_jobs")
}

model ExternalCustomerIdentity {
  id             String                @id @default(cuid())
  businessId     String                @map("business_id")
  connectionId   String                @map("connection_id")
  externalUserId String                @map("external_user_id")
  displayName    String?               @map("display_name")
  customerId     String?               @map("customer_id")
  linkedAt       DateTime?             @map("linked_at")
  linkedById     String?               @map("linked_by_id")
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  customer       Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  linkedBy       StaffUser?            @relation("IdentityLinkConfirmer", fields: [linkedById], references: [id], onDelete: Restrict)
  conversations  Conversation[]

  @@unique([connectionId, externalUserId])
  @@index([businessId, customerId])
  @@map("external_customer_identities")
}

model CustomerDuplicateSuggestion {
  id                  String                  @id @default(cuid())
  businessId          String                  @map("business_id")
  suggestionKey       String                  @map("suggestion_key")
  customerAId         String                  @map("customer_a_id")
  customerBId         String                  @map("customer_b_id")
  evidence            Json
  evidenceFingerprint String                  @map("evidence_fingerprint")
  status              CustomerDuplicateStatus @default(PENDING)
  decisionReason      String?                 @map("decision_reason")
  decidedById         String?                 @map("decided_by_id")
  decidedAt           DateTime?               @map("decided_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  business            Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerA           Customer                @relation("DuplicateCustomerA", fields: [customerAId], references: [id], onDelete: Restrict)
  customerB           Customer                @relation("DuplicateCustomerB", fields: [customerBId], references: [id], onDelete: Restrict)
  decidedBy           StaffUser?              @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([businessId, suggestionKey])
  @@index([businessId, status, createdAt], map: "customer_duplicate_suggestions_business_id_status_created_at_id")
  @@index([businessId, customerAId, customerBId], map: "customer_duplicate_suggestions_business_id_customer_a_id_custom")
  @@map("customer_duplicate_suggestions")
}

model CustomerMergeCommand {
  id             String    @id @default(cuid())
  businessId     String    @map("business_id")
  idempotencyKey String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  sourceId       String    @map("source_id")
  targetId       String    @map("target_id")
  actorId        String    @map("actor_id")
  response       Json
  createdAt      DateTime  @default(now()) @map("created_at")
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  source         Customer  @relation("MergeSourceCustomer", fields: [sourceId], references: [id], onDelete: Restrict)
  target         Customer  @relation("MergeTargetCustomer", fields: [targetId], references: [id], onDelete: Restrict)
  actor          StaffUser @relation("CustomerMergeActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, sourceId, createdAt])
  @@map("customer_merge_commands")
}

model Conversation {
  id              String                     @id @default(cuid())
  businessId      String                     @map("business_id")
  connectionId    String                     @map("connection_id")
  identityId      String?                    @map("identity_id")
  externalId      String                     @map("external_id")
  subject         String?
  status          ConversationStatus         @default(OPEN)
  assignedStaffId String?                    @map("assigned_staff_id")
  unreadAt        DateTime?                  @map("unread_at")
  lastMessageAt   DateTime?                  @map("last_message_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  business        Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  connection      IntegrationConnection      @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  identity        ExternalCustomerIdentity?  @relation(fields: [identityId], references: [id], onDelete: Restrict)
  assignedStaff   StaffUser?                 @relation("ConversationAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages        ConversationMessage[]
  notes           InternalConversationNote[]
  tickets         SocialTicket[]
  outbounds       SocialOutbound[]
  sourceQuotes    Quote[]                    @relation("QuoteSourceConversation")

  @@unique([connectionId, externalId])
  @@index([businessId, status, lastMessageAt])
  @@index([businessId, assignedStaffId, status])
  @@map("conversations")
}

model ConversationMessage {
  id                String                       @id @default(cuid())
  connectionId      String                       @map("connection_id")
  conversationId    String                       @map("conversation_id")
  externalMessageId String                       @map("external_message_id")
  direction         IntegrationResourceDirection @default(INBOUND)
  contentType       String                       @default("text") @map("content_type")
  body              String?
  mediaMetadata     Json?                        @map("media_metadata")
  providerAt        DateTime                     @map("provider_at")
  importJobId       String?                      @map("import_job_id")
  createdAt         DateTime                     @default(now()) @map("created_at")
  connection        IntegrationConnection        @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  conversation      Conversation                 @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sourceQuotes      Quote[]                      @relation("QuoteSourceMessage")

  @@unique([connectionId, externalMessageId])
  @@index([conversationId, providerAt])
  @@index([importJobId])
  @@map("conversation_messages")
}

model InternalConversationNote {
  id             String       @id @default(cuid())
  businessId     String       @map("business_id")
  conversationId String       @map("conversation_id")
  createdById    String       @map("created_by_id")
  body           String
  createdAt      DateTime     @default(now()) @map("created_at")
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  createdBy      StaffUser    @relation("ConversationNoteAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@map("internal_conversation_notes")
}

model SocialComment {
  id                String                @id @default(cuid())
  businessId        String                @map("business_id")
  connectionId      String                @map("connection_id")
  externalCommentId String                @map("external_comment_id")
  externalPostId    String                @map("external_post_id")
  externalParentId  String?               @map("external_parent_id")
  externalAuthorId  String?               @map("external_author_id")
  authorDisplayName String?               @map("author_display_name")
  body              String?
  sourceUrl         String?               @map("source_url")
  status            String                @default("ACTIVE")
  providerAt        DateTime              @map("provider_at")
  importJobId       String?               @map("import_job_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  connection        IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  tickets           SocialTicket[]
  outbounds         SocialOutbound[]

  @@unique([connectionId, externalCommentId])
  @@index([businessId, providerAt])
  @@index([connectionId, externalPostId, providerAt])
  @@index([importJobId])
  @@map("social_comments")
}

model SocialOutbound {
  id               String                @id @default(cuid())
  businessId       String                @map("business_id")
  connectionId     String                @map("connection_id")
  conversationId   String?               @map("conversation_id")
  commentId        String?               @map("comment_id")
  actorId          String                @map("actor_id")
  requestKey       String                @map("request_key")
  kind             SocialOutboundKind
  status           SocialOutboundStatus  @default(PENDING)
  body             String
  providerObjectId String?               @map("provider_object_id")
  errorCode        String?               @map("error_code")
  attemptedAt      DateTime?             @map("attempted_at")
  acceptedAt       DateTime?             @map("accepted_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  business         Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  connection       IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  conversation     Conversation?         @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  comment          SocialComment?        @relation(fields: [commentId], references: [id], onDelete: Restrict)
  actor            StaffUser             @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([businessId, requestKey])
  @@unique([connectionId, providerObjectId])
  @@index([conversationId, createdAt])
  @@index([commentId, createdAt])
  @@map("social_outbounds")
}

model SocialTicket {
  id              String               @id @default(cuid())
  businessId      String               @map("business_id")
  conversationId  String?              @map("conversation_id")
  commentId       String?              @map("comment_id")
  requestKey      String               @map("request_key")
  kind            SocialTicketKind
  priority        SocialTicketPriority @default(NORMAL)
  status          SocialTicketStatus   @default(OPEN)
  summary         String
  labels          String[]             @default([])
  sourceUrl       String?              @map("source_url")
  assignedStaffId String?              @map("assigned_staff_id")
  createdById     String               @map("created_by_id")
  version         Int                  @default(1)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversation    Conversation?        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  comment         SocialComment?       @relation(fields: [commentId], references: [id], onDelete: Restrict)
  assignedStaff   StaffUser?           @relation("SocialTicketAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdBy       StaffUser            @relation("SocialTicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  events          SocialTicketEvent[]
  sourceQuotes    Quote[]              @relation("QuoteSourceTicket")

  @@unique([businessId, requestKey])
  @@index([businessId, status, updatedAt])
  @@index([businessId, assignedStaffId, status])
  @@index([conversationId])
  @@index([commentId])
  @@map("social_tickets")
}

model SocialTicketEvent {
  id         String       @id @default(cuid())
  businessId String       @map("business_id")
  ticketId   String       @map("ticket_id")
  actorId    String       @map("actor_id")
  action     String
  changes    Json
  createdAt  DateTime     @default(now()) @map("created_at")
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  ticket     SocialTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor      StaffUser    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("social_ticket_events")
}

model ExternalOrder {
  id                String                @id @default(cuid())
  businessId        String                @map("business_id")
  connectionId      String                @map("connection_id")
  externalOrderId   String                @map("external_order_id")
  sourceStatus      String                @map("source_status")
  normalizedStatus  String                @map("normalized_status")
  providerCreatedAt DateTime?             @map("provider_created_at")
  providerUpdatedAt DateTime?             @map("provider_updated_at")
  currency          String
  totalAmount       Decimal?              @map("total_amount") @db.Decimal(20, 6)
  recipientSnapshot Json?                 @map("recipient_snapshot")
  customerId        String?               @map("customer_id")
  salesOrderId      String?               @unique @map("sales_order_id")
  alertedAt         DateTime?             @map("alerted_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  connection        IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  customer          Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder        SalesOrder?           @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  lines             ExternalOrderLine[]
  alerts            AdminAlert[]

  @@unique([connectionId, externalOrderId])
  @@index([businessId, normalizedStatus, providerCreatedAt])
  @@index([businessId, providerUpdatedAt])
  @@map("external_orders")
}

model ExternalOrderLine {
  id                String          @id @default(cuid())
  externalOrderId   String          @map("external_order_id")
  externalProductId String?         @map("external_product_id")
  externalModelId   String?         @map("external_model_id")
  sourceSku         String?         @map("source_sku")
  titleSnapshot     String          @map("title_snapshot")
  quantity          Decimal         @db.Decimal(20, 6)
  sourceUnit        String?         @map("source_unit")
  unitPrice         Decimal?        @map("unit_price") @db.Decimal(20, 6)
  lineAmount        Decimal?        @map("line_amount") @db.Decimal(20, 6)
  variantId         String?         @map("variant_id")
  conversionFactor  Decimal?        @map("conversion_factor") @db.Decimal(20, 6)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  externalOrder     ExternalOrder   @relation(fields: [externalOrderId], references: [id], onDelete: Restrict)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([externalOrderId])
  @@index([variantId])
  @@map("external_order_lines")
}

model ExternalProductMapping {
  id                String                @id @default(cuid())
  businessId        String                @map("business_id")
  connectionId      String                @map("connection_id")
  externalProductId String                @map("external_product_id")
  externalModelId   String                @default("") @map("external_model_id")
  variantId         String                @map("variant_id")
  conversionFactor  Decimal               @map("conversion_factor") @db.Decimal(20, 6)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  connection        IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  variant           ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([connectionId, externalProductId, externalModelId])
  @@index([businessId, variantId])
  @@map("external_product_mappings")
}

model Shipment {
  id                   String          @id @default(cuid())
  businessId           String          @map("business_id")
  orderId              String          @unique @map("order_id")
  warehouseId          String          @map("warehouse_id")
  shipmentCode         String          @map("shipment_code")
  status               ShipmentStatus  @default(IN_TRANSIT)
  version              Int             @default(1)
  shippedById          String          @map("shipped_by_id")
  shippedAt            DateTime        @map("shipped_at")
  deliveredById        String?         @map("delivered_by_id")
  deliveredAt          DateTime?       @map("delivered_at")
  recognizedRevenueVnd Decimal         @default(0) @map("recognized_revenue_vnd") @db.Decimal(20, 0)
  createdAt            DateTime        @default(now()) @map("created_at")
  business             Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  order                SalesOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouse            Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  shippedBy            StaffUser       @relation("ShipmentCreator", fields: [shippedById], references: [id], onDelete: Restrict)
  deliveredBy          StaffUser?      @relation("ShipmentDeliverer", fields: [deliveredById], references: [id], onDelete: Restrict)
  lines                ShipmentLine[]
  returnRequests       ReturnRequest[]

  @@unique([businessId, shipmentCode])
  @@index([businessId, status, shippedAt])
  @@index([businessId, deliveredAt])
  @@map("shipments")
}

model ShipmentLine {
  id                  String         @id @default(cuid())
  shipmentId          String         @map("shipment_id")
  orderLineId         String         @unique @map("order_line_id")
  variantId           String         @map("variant_id")
  productNameSnapshot String         @map("product_name_snapshot")
  skuSnapshot         String         @map("sku_snapshot")
  variantNameSnapshot String         @map("variant_name_snapshot")
  unitCodeSnapshot    String         @map("unit_code_snapshot")
  unitNameSnapshot    String         @map("unit_name_snapshot")
  quantity            Decimal        @db.Decimal(20, 6)
  baseQuantity        Decimal        @map("base_quantity") @db.Decimal(20, 6)
  unitCostVnd         Decimal        @map("unit_cost_vnd") @db.Decimal(20, 6)
  valueDeltaVnd       Decimal        @map("value_delta_vnd") @db.Decimal(20, 0)
  shipment            Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  orderLine           SalesOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  stockMovement       StockMovement?
  returnLines         ReturnLine[]

  @@index([shipmentId, id])
  @@index([variantId, shipmentId])
  @@map("shipment_lines")
}

model ReturnRequest {
  id             String              @id @default(cuid())
  businessId     String              @map("business_id")
  shipmentId     String              @map("shipment_id")
  orderId        String              @map("order_id")
  customerId     String              @map("customer_id")
  warehouseId    String              @map("warehouse_id")
  receivedById   String              @map("received_by_id")
  inspectedById  String?             @map("inspected_by_id")
  status         ReturnRequestStatus @default(RECEIVED)
  deliveredAt    DateTime            @map("delivered_at")
  deadlineAt     DateTime            @map("deadline_at")
  policyDays     Int                 @map("policy_days")
  version        Int                 @default(1)
  idempotencyKey String              @map("idempotency_key")
  requestHash    String              @map("request_hash")
  notes          String?
  receivedAt     DateTime            @map("received_at")
  inspectedAt    DateTime?           @map("inspected_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  shipment       Shipment            @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  order          SalesOrder          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy     StaffUser           @relation("ReturnReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  inspectedBy    StaffUser?          @relation("ReturnInspector", fields: [inspectedById], references: [id], onDelete: Restrict)
  lines          ReturnLine[]
  inspections    ReturnInspection[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, receivedAt])
  @@index([shipmentId, createdAt])
  @@map("return_requests")
}

model ReturnLine {
  id                  String            @id @default(cuid())
  requestId           String            @map("request_id")
  shipmentLineId      String            @map("shipment_line_id")
  variantId           String            @map("variant_id")
  productNameSnapshot String            @map("product_name_snapshot")
  skuSnapshot         String            @map("sku_snapshot")
  variantNameSnapshot String            @map("variant_name_snapshot")
  unitCodeSnapshot    String            @map("unit_code_snapshot")
  unitNameSnapshot    String            @map("unit_name_snapshot")
  quantity            Decimal           @db.Decimal(20, 6)
  baseQuantity        Decimal           @map("base_quantity") @db.Decimal(20, 6)
  saleableQuantity    Decimal?          @map("saleable_quantity") @db.Decimal(20, 6)
  quarantineQuantity  Decimal?          @map("quarantine_quantity") @db.Decimal(20, 6)
  unitCostVnd         Decimal           @map("unit_cost_vnd") @db.Decimal(20, 6)
  inspectedAt         DateTime?         @map("inspected_at")
  request             ReturnRequest     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  shipmentLine        ShipmentLine      @relation(fields: [shipmentLineId], references: [id], onDelete: Restrict)
  variant             ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  inspection          ReturnInspection?
  stockMovement       StockMovement?

  @@unique([requestId, shipmentLineId])
  @@index([shipmentLineId])
  @@map("return_lines")
}

model ReturnInspection {
  id          String        @id @default(cuid())
  requestId   String        @map("request_id")
  lineId      String        @unique @map("line_id")
  inspectorId String        @map("inspector_id")
  reason      String?
  inspectedAt DateTime      @map("inspected_at")
  request     ReturnRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  line        ReturnLine    @relation(fields: [lineId], references: [id], onDelete: Restrict)
  inspector   StaffUser     @relation(fields: [inspectorId], references: [id], onDelete: Restrict)

  @@index([requestId, inspectedAt])
  @@map("return_inspections")
}

model ReturnCommand {
  id             String    @id @default(cuid())
  businessId     String    @map("business_id")
  idempotencyKey String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  response       Json
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy      StaffUser @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@map("return_commands")
}

model PaymentReceipt {
  id             String                @id @default(cuid())
  businessId     String                @map("business_id")
  customerId     String                @map("customer_id")
  createdById    String                @map("created_by_id")
  amountVnd      Decimal               @map("amount_vnd") @db.Decimal(20, 0)
  receivedAt     DateTime              @map("received_at")
  reference      String?
  note           String?
  idempotencyKey String                @map("idempotency_key")
  requestHash    String                @map("request_hash")
  createdAt      DateTime              @default(now()) @map("created_at")
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy      StaffUser             @relation("PaymentRecorder", fields: [createdById], references: [id], onDelete: Restrict)
  allocations    PaymentAllocation[]
  creditEvents   CustomerCreditEvent[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, customerId, receivedAt])
  @@map("payment_receipts")
}

model PaymentAllocation {
  id          String                 @id @default(cuid())
  paymentId   String                 @map("payment_id")
  orderId     String                 @map("order_id")
  amountVnd   Decimal                @map("amount_vnd") @db.Decimal(20, 0)
  createdAt   DateTime               @default(now()) @map("created_at")
  payment     PaymentReceipt         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order       SalesOrder             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  settlements ReceivableSettlement[]

  @@unique([paymentId, orderId])
  @@index([orderId, createdAt])
  @@map("payment_allocations")
}

model Receivable {
  id          String                 @id @default(cuid())
  businessId  String                 @map("business_id")
  customerId  String                 @map("customer_id")
  orderId     String                 @unique @map("order_id")
  createdById String                 @map("created_by_id")
  amountVnd   Decimal                @map("amount_vnd") @db.Decimal(20, 0)
  balanceVnd  Decimal                @map("balance_vnd") @db.Decimal(20, 0)
  createdAt   DateTime               @default(now()) @map("created_at")
  business    Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order       SalesOrder             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy   StaffUser              @relation("ReceivableCreator", fields: [createdById], references: [id], onDelete: Restrict)
  settlements ReceivableSettlement[]

  @@index([businessId, customerId, createdAt])
  @@map("receivables")
}

model ReceivableSettlement {
  id                  String                     @id @default(cuid())
  receivableId        String                     @map("receivable_id")
  paymentAllocationId String?                    @map("payment_allocation_id")
  creditApplicationId String?                    @map("credit_application_id")
  amountVnd           Decimal                    @map("amount_vnd") @db.Decimal(20, 0)
  createdAt           DateTime                   @default(now()) @map("created_at")
  receivable          Receivable                 @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  paymentAllocation   PaymentAllocation?         @relation(fields: [paymentAllocationId], references: [id], onDelete: Restrict)
  creditApplication   CustomerCreditApplication? @relation(fields: [creditApplicationId], references: [id], onDelete: Restrict)

  @@unique([paymentAllocationId])
  @@unique([creditApplicationId])
  @@index([receivableId, createdAt])
  @@map("receivable_settlements")
}

model CustomerCreditBalance {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  customerId String   @unique @map("customer_id")
  balanceVnd Decimal  @default(0) @map("balance_vnd") @db.Decimal(20, 0)
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt @map("updated_at")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([businessId, customerId])
  @@map("customer_credit_balances")
}

model CustomerCreditApplication {
  id             String                          @id @default(cuid())
  businessId     String                          @map("business_id")
  customerId     String                          @map("customer_id")
  orderId        String                          @map("order_id")
  createdById    String                          @map("created_by_id")
  amountVnd      Decimal                         @map("amount_vnd") @db.Decimal(20, 0)
  status         CustomerCreditApplicationStatus @default(ACTIVE)
  idempotencyKey String                          @map("idempotency_key")
  requestHash    String                          @map("request_hash")
  response       Json?
  createdAt      DateTime                        @default(now()) @map("created_at")
  updatedAt      DateTime                        @updatedAt @map("updated_at")
  business       Business                        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer       Customer                        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order          SalesOrder                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy      StaffUser                       @relation("CustomerCreditApplicationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  events         CustomerCreditEvent[]
  settlement     ReceivableSettlement?

  @@unique([businessId, idempotencyKey])
  @@index([businessId, customerId, createdAt])
  @@index([orderId, status])
  @@map("customer_credit_applications")
}

model CustomerCreditEvent {
  id            String                     @id @default(cuid())
  businessId    String                     @map("business_id")
  customerId    String                     @map("customer_id")
  paymentId     String?                    @map("payment_id")
  applicationId String?                    @map("application_id")
  eventKey      String                     @map("event_key")
  type          CustomerCreditEventType
  amountVnd     Decimal                    @map("amount_vnd") @db.Decimal(20, 0)
  occurredAt    DateTime                   @map("occurred_at")
  createdAt     DateTime                   @default(now()) @map("created_at")
  business      Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer      Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payment       PaymentReceipt?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  application   CustomerCreditApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([businessId, eventKey])
  @@index([businessId, customerId, occurredAt])
  @@index([applicationId])
  @@map("customer_credit_events")
}
