generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StaffStatus {
  ACTIVE
  LOCKED
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum ContactType {
  PHONE
  EMAIL
}

enum AddressStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  OPEN
  DONE
  CANCELED
}

enum OpportunityStage {
  NEW
  QUALIFIED
  WON
  LOST
}

enum OpportunityKind {
  FIRST_PURCHASE
  REPEAT_PURCHASE
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum MediaStatus {
  ACTIVE
  ARCHIVED
}

enum SupplierStatus {
  ACTIVE
  ARCHIVED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  CANCELED
}

model Business {
  id               String             @id @default(cuid())
  name             String
  timezone         String             @default("Asia/Ho_Chi_Minh")
  currency         String             @default("VND")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  staff            StaffUser[]
  roles            Role[]
  audits           AuditLog[]
  customerGroups   CustomerGroup[]
  customers        Customer[]
  customerContacts ContactPoint[]
  customerTasks    CustomerTask[]
  opportunities    SalesOpportunity[]
  products         Product[]
  productVariants  ProductVariant[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]

  @@map("businesses")
}

model StaffUser {
  id                    String             @id @default(cuid())
  businessId            String             @map("business_id")
  email                 String
  emailNormalized       String             @unique @map("email_normalized")
  displayName           String             @map("display_name")
  passwordHash          String             @map("password_hash")
  status                StaffStatus        @default(ACTIVE)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  business              Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  roles                 StaffUserRole[]
  sessions              Session[]
  audits                AuditLog[]         @relation("AuditActor")
  assignedCustomers     Customer[]         @relation("CustomerAssignee")
  assignedTasks         CustomerTask[]     @relation("TaskAssignee")
  assignedOpportunities SalesOpportunity[] @relation("OpportunityAssignee")
  createdPurchaseOrders PurchaseOrder[]    @relation("PurchaseOrderCreator")

  @@index([businessId, status])
  @@map("staff_users")
}

model Role {
  id          String           @id @default(cuid())
  businessId  String           @map("business_id")
  code        String
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  staff       StaffUserRole[]

  @@unique([businessId, code])
  @@map("roles")
}

model Permission {
  key         String           @id
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String     @map("role_id")
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model StaffUserRole {
  staffUserId String    @map("staff_user_id")
  roleId      String    @map("role_id")
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffUserId, roleId])
  @@map("staff_user_roles")
}

model Session {
  id          String    @id
  staffUserId String    @map("staff_user_id")
  expiresAt   DateTime  @map("expires_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  revokedAt   DateTime? @map("revoked_at")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("sessions")
}

model AuditLog {
  id         String     @id @default(cuid())
  businessId String     @map("business_id")
  actorId    String?    @map("actor_id")
  action     String
  entityType String     @map("entity_type")
  entityId   String?    @map("entity_id")
  requestId  String?    @map("request_id")
  metadata   Json?
  createdAt  DateTime   @default(now()) @map("created_at")
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor      StaffUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model CustomerGroup {
  id          String     @id @default(cuid())
  businessId  String     @map("business_id")
  code        String
  name        String
  description String?
  isSystem    Boolean    @default(false) @map("is_system")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customers   Customer[]

  @@unique([businessId, code])
  @@map("customer_groups")
}

model Customer {
  id               String             @id @default(cuid())
  businessId       String             @map("business_id")
  customerCode     String             @map("customer_code")
  displayName      String             @map("display_name")
  nameNormalized   String             @map("name_normalized")
  groupId          String             @map("group_id")
  source           String?
  legalName        String?            @map("legal_name")
  taxCode          String?            @map("tax_code")
  notes            String?
  marketingConsent Boolean            @default(false) @map("marketing_consent")
  assignedStaffId  String?            @map("assigned_staff_id")
  status           CustomerStatus     @default(ACTIVE)
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  group            CustomerGroup      @relation(fields: [groupId], references: [id], onDelete: Restrict)
  assignedStaff    StaffUser?         @relation("CustomerAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  contacts         ContactPoint[]
  addresses        Address[]
  tasks            CustomerTask[]
  opportunities    SalesOpportunity[]

  @@unique([businessId, customerCode])
  @@index([businessId, status, updatedAt])
  @@index([businessId, nameNormalized])
  @@map("customers")
}

model ContactPoint {
  id              String      @id @default(cuid())
  businessId      String      @map("business_id")
  customerId      String      @map("customer_id")
  type            ContactType
  value           String
  normalizedValue String      @map("normalized_value")
  label           String?
  isPrimary       Boolean     @default(false) @map("is_primary")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, type, normalizedValue])
  @@index([businessId, type, normalizedValue])
  @@map("contact_points")
}

model Address {
  id            String        @id @default(cuid())
  customerId    String        @map("customer_id")
  label         String?
  recipientName String?       @map("recipient_name")
  phone         String?
  line1         String
  ward          String?
  district      String?
  province      String
  countryCode   String        @default("VN") @map("country_code")
  isDefault     Boolean       @default(false) @map("is_default")
  status        AddressStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, status])
  @@map("addresses")
}

model CustomerTask {
  id              String     @id @default(cuid())
  businessId      String     @map("business_id")
  customerId      String     @map("customer_id")
  assignedStaffId String?    @map("assigned_staff_id")
  title           String
  description     String?
  dueAt           DateTime?  @map("due_at")
  status          TaskStatus @default(OPEN)
  completedAt     DateTime?  @map("completed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer        Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedStaff   StaffUser? @relation("TaskAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([businessId, status, dueAt])
  @@index([customerId, createdAt])
  @@map("customer_tasks")
}

model SalesOpportunity {
  id              String           @id @default(cuid())
  businessId      String           @map("business_id")
  customerId      String           @map("customer_id")
  assignedStaffId String?          @map("assigned_staff_id")
  title           String
  kind            OpportunityKind
  stage           OpportunityStage @default(NEW)
  note            String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedStaff   StaffUser?       @relation("OpportunityAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([businessId, stage, updatedAt])
  @@index([customerId, createdAt])
  @@map("sales_opportunities")
}

model Product {
  id          String           @id @default(cuid())
  businessId  String           @map("business_id")
  name        String
  description String?
  category    String?
  brand       String?
  status      CatalogStatus    @default(ACTIVE)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  media       MediaAsset[]

  @@index([businessId, status, updatedAt])
  @@index([businessId, name])
  @@map("products")
}

model ProductVariant {
  id                 String              @id @default(cuid())
  businessId         String              @map("business_id")
  productId          String              @map("product_id")
  sku                String
  name               String
  barcode            String?
  baseUnitCode       String              @map("base_unit_code")
  baseUnitName       String              @map("base_unit_name")
  attributes         Json?
  status             CatalogStatus       @default(ACTIVE)
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  conversions        UnitConversion[]
  media              MediaAsset[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([productId, status])
  @@map("product_variants")
}

model UnitConversion {
  id        String         @id @default(cuid())
  variantId String         @map("variant_id")
  unitCode  String         @map("unit_code")
  unitName  String         @map("unit_name")
  factor    Decimal        @db.Decimal(20, 6)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, unitCode])
  @@map("unit_conversions")
}

model MediaAsset {
  id        String          @id @default(cuid())
  productId String          @map("product_id")
  variantId String?         @map("variant_id")
  url       String
  altText   String?         @map("alt_text")
  sortOrder Int             @default(0) @map("sort_order")
  status    MediaStatus     @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([productId, status, sortOrder])
  @@index([variantId, status])
  @@map("media_assets")
}

model Supplier {
  id             String          @id @default(cuid())
  businessId     String          @map("business_id")
  supplierCode   String          @map("supplier_code")
  name           String
  contactName    String?         @map("contact_name")
  phone          String?
  email          String?
  taxCode        String?         @map("tax_code")
  address        String?
  notes          String?
  status         SupplierStatus  @default(ACTIVE)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([businessId, supplierCode])
  @@index([businessId, status, updatedAt])
  @@index([businessId, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  businessId  String              @map("business_id")
  supplierId  String              @map("supplier_id")
  orderNumber String              @map("order_number")
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?           @map("expected_at")
  notes       String?
  version     Int                 @default(1)
  orderedAt   DateTime?           @map("ordered_at")
  canceledAt  DateTime?           @map("canceled_at")
  createdById String              @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   StaffUser           @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines       PurchaseOrderLine[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status, updatedAt])
  @@index([supplierId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                       String         @id @default(cuid())
  purchaseOrderId          String         @map("purchase_order_id")
  variantId                String         @map("variant_id")
  lineNumber               Int            @map("line_number")
  productNameSnapshot      String         @map("product_name_snapshot")
  skuSnapshot              String         @map("sku_snapshot")
  variantNameSnapshot      String         @map("variant_name_snapshot")
  unitCodeSnapshot         String         @map("unit_code_snapshot")
  unitNameSnapshot         String         @map("unit_name_snapshot")
  conversionFactorSnapshot Decimal        @map("conversion_factor_snapshot") @db.Decimal(20, 6)
  orderedQuantity          Decimal        @map("ordered_quantity") @db.Decimal(20, 6)
  baseQuantity             Decimal        @map("base_quantity") @db.Decimal(20, 6)
  expectedUnitCostVnd      Decimal?       @map("expected_unit_cost_vnd") @db.Decimal(20, 0)
  createdAt                DateTime       @default(now()) @map("created_at")
  purchaseOrder            PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant                  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, lineNumber])
  @@index([variantId, createdAt])
  @@map("purchase_order_lines")
}
